NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres — local docker, nunca apontar pra prod em dev
DATABASE_URL=postgres://kami:kami@localhost:5432/kami_backend

# Sessao — o front grava o cookie assinado com este segredo, o back so valida (ADR-021)
SESSION_COOKIE_NAME=session
SESSION_SECRET=troque-este-valor-em-cada-ambiente

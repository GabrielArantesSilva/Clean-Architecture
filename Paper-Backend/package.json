{
  "name": "kami-backend",
  "version": "0.1.0",
  "description": "Implementação de referência do back-end Node.js da Origami Lab (ADR-021, harness-core).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server/index.ts",
    "build": "tsup",
    "start": "node --env-file=.env dist/server/index.js",
    "start:test": "tsx scripts/start-test-server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:up": "tsx src/testing/cli-up.ts",
    "test:unit": "vitest run --exclude '**/*.database.spec.ts'",
    "test:db": "vitest run database.spec",
    "test": "pnpm run test:unit && pnpm run test:db",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@scalar/fastify-api-reference": "^1.63.0",
    "@specter-labs/fastify-logger": "^1.0.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fast-jwt": "^6.2.4",
    "fastify": "^5.9.0",
    "fastify-plugin": "^6.0.0",
    "nanoid": "^5.1.16",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typebox": "^1.3.2"
  },
  "devDependencies": {
    "@specter-labs/eslint-config": "^1.1.7",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^2.1.9",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9",
    "vitest-mock-extended": "^2.0.2"
  }
}